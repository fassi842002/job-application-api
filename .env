# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> job application api ###
# Endpoint of the vacancies API: https://jobs.example.com/api/apply/<vacancy-slug>
# The slug is the last segment of a vacancy URL on https://jobs.example.com/vacancies,
# e.g. .../vacancies/development/senior-php-developer-42 -> "senior-php-developer-42".
#
# jobs.example.com is a documentation placeholder (RFC 2606) that resolves to no real
# service, and every value below is a placeholder: put your real values in .env.local
# (git-ignored), never in this committed file.
JOB_API_URL=https://jobs.example.com/api/apply/your-vacancy-slug
JOB_APPLICANT_FIRST_NAME=your-first-name
JOB_APPLICANT_LAST_NAME=your-last-name
JOB_APPLICANT_EMAIL=you@example.com
JOB_APPLICANT_TELEPHONE=your-phone-number
# Motivation, max 5000 characters. Leave empty to omit it from the payload.
JOB_APPLICANT_MOTIVATION=
# Your CV as base64 WITHOUT the "data:application/pdf;base64," prefix (see README).
# Leave empty to apply without a CV.
JOB_APPLICANT_CV=
# Extension of the CV, default "pdf". Only sent when JOB_APPLICANT_CV is filled in.
JOB_APPLICANT_CV_EXTENSION=pdf
JOB_APPLICANT_LINKEDIN=
JOB_APPLICANT_GITHUB=
###< job application api ###
